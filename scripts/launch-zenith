#!/usr/bin/env bash
set -euo pipefail

systemctl --user start zenith-app.service
for _attempt in $(seq 1 40); do
  if curl --fail --silent --max-time 1 http://127.0.0.1:38421/api/health >/dev/null; then
    exec xdg-open http://127.0.0.1:38421/
  fi
  sleep 0.25
done
echo "Zenith did not become ready in time." >&2
exit 1
