{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "bridge/src",
    "outDir": "dist-bridge",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["bridge/src/**/*.ts"],
  "exclude": ["bridge/src/**/*.test.ts"]
}
