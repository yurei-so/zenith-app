{
  "name": "zenith-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c yellow,cyan \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:bridge": "tsx watch bridge/src/index.ts",
    "bridge:mock": "tsx bridge/src/index.ts --mock",
    "bridge:mumble": "tsx bridge/src/index.ts --mumble",
    "bridge:proton": "tsx bridge/src/index.ts --proton",
    "build:proton-relay": "scripts/build-proton-relay.sh",
    "build": "tsc -b && tsc -p tsconfig.bridge-build.json && vite build",
    "start": "node dist-bridge/index.js --proton",
    "check": "tsc -b && eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "koffi": "^3.1.2",
    "ol": "^10.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
